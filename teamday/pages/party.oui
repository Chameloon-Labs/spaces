# Team Day · cake at 3 pm
# The launch-day cake in the kitchen: tap I'm in and your sticker joins the guests.
root = Page([header, stats, join, going], "Cake at 3 pm")

c = Query("query", {sql: "SELECT (SELECT count(*) FROM party) AS going, (SELECT count(*) FROM team) AS total, (SELECT count(*) FROM party WHERE key = 'finn') AS me"}, {rows: [{going: 0, total: 1, me: 0}]})
g = Query("query", {sql: "SELECT p.name AS name, '/img/tw_' || p.key || '.png' AS art, strftime('%H:%M', p.created, 'localtime') AS at FROM party p ORDER BY p.created DESC, p.rowid DESC"}, {rows: []})
rsvp = Mutation("run", {sql: "INSERT INTO party (key, name) SELECT 'finn', 'You' WHERE NOT EXISTS (SELECT 1 FROM party WHERE key = 'finn')"})

header = Image("/img/s_cake.png", "Cake")
stats = Stats([Stat("Going", c.rows[0].going + "", "of " + c.rows[0].total + " on the team"), Stat("Where", "Kitchen", "15:00, bring a fork")])
join = c.rows[0].me == 1 ? Alert("You're in", "See you at 3 pm. Save a slice.", "success") : Buttons([Button("🎂 I'm in", Action([@Run(rsvp), @Run(c), @Run(g), @Haptic("success"), @Confetti()]), "default", "lg")])
going = Tiles(@Each(g.rows, "x", Tile(x.name, "RSVP " + x.at, x.art, "Going")), 3)
