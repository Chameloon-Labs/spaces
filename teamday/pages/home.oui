# Team Day · board
# Who is in, remote or out sick today, with their excuses; call in sick yourself with one tap.
root = Page([stats, call, people, pie, cake], "Team Day")

$excuse = "Terrible cough"

n = Query("query", {sql: "SELECT (SELECT count(*) FROM team WHERE status = 'sick') AS sick, (SELECT count(*) FROM team WHERE status = 'in') AS inn, (SELECT count(*) FROM team WHERE status = 'remote') AS remote, (SELECT count(*) FROM team) AS total, (SELECT status FROM team WHERE me = 1) AS mine"}, {rows: [{sick: 0, inn: 0, remote: 0, total: 1, mine: "in"}]})
list = Query("query", {sql: "SELECT name, role, status, excuse, CASE status WHEN 'sick' THEN 'Sick' WHEN 'remote' THEN 'Remote' ELSE 'In office' END AS label, CASE WHEN status = 'sick' THEN '/img/tw_' || key || '-sick.png' ELSE '/img/tw_' || key || '.png' END AS art FROM team ORDER BY n"}, {rows: []})
sick = Mutation("run", {sql: "UPDATE team SET status = 'sick', excuse = ? WHERE me = 1", params: [$excuse]})

stats = Stats([Stat("Out sick", n.rows[0].sick + " of " + n.rows[0].total, n.rows[0].sick >= 5 ? "the whole team" : "so far today"), Stat("In the office", n.rows[0].inn + "", n.rows[0].remote + " remote")])
call = n.rows[0].mine == "sick" ? Alert("Get well soon", "You are out sick today. The team has been told.", "success") : Card([CardHeader("Not feeling great?", "Pick an excuse"), Chips(["Terrible cough", "My cat is sick", "Food poisoning (again)", "Migraine"], $excuse), Buttons([Button("🤧 Call in sick", Action([@Run(sick), @Run(list), @Run(n), @Haptic("warning"), @Sound("error")]), "default", "lg")])])
people = Tiles(@Each(list.rows, "p", Tile(p.name, p.excuse, p.art, p.label)), 3)
pie = Card([CardHeader("Today at a glance", "Where everyone is"), PieChart([Slice("Sick", n.rows[0].sick), Slice("Office", n.rows[0].inn), Slice("Remote", n.rows[0].remote)], true)])
cake = Buttons([Button("🎂 Cake at 3 pm: I'm in", Action([@Navigate("party")]), "outline", "lg")])
