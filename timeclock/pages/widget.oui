today = Query("query", {sql: "WITH e AS (SELECT kind, at, coalesce(lead(at) OVER (ORDER BY at, rowid), CASE WHEN kind = 'end' THEN at ELSE datetime('now', 'localtime') END) AS nxt FROM entries WHERE date(at) = date('now', 'localtime')), m AS (SELECT kind, coalesce(sum(round((julianday(nxt) - julianday(at)) * 1440)), 0) AS n FROM e GROUP BY kind), t AS (SELECT CAST(coalesce(sum(CASE WHEN kind IN ('work', 'trip') THEN n END), 0) AS INTEGER) AS work, CAST(coalesce(sum(CASE WHEN kind = 'break' THEN n END), 0) AS INTEGER) AS brk FROM m), last AS (SELECT kind FROM entries WHERE date(at) = date('now', 'localtime') ORDER BY at DESC, rowid DESC LIMIT 1) SELECT CASE WHEN (SELECT kind FROM last) IS NULL THEN 'Not started' WHEN (SELECT kind FROM last) = 'end' THEN 'Done' ELSE 'Running' END AS state, printf('%d:%02d', work / 60, work % 60) AS worked, printf('%d:%02d', brk / 60, brk % 60) AS paused, work, brk FROM t"}, {rows: [{state: "Not started", worked: "0:00", paused: "0:00", work: 0, brk: 0}]})
head = Row([Icon("clock.fill", {color: "#0F766E", size: 18}), Text("Time clock", "caption", {color: "#0F766E", weight: "semibold", lineLimit: 1}), Spacer()], 6)
state = Text(today.rows[0].state, "title3", {weight: "semibold"})
small = Widget([head, Spacer(), state, Text("Work " + today.rows[0].worked, "headline"), Text("Break " + today.rows[0].paused, "caption")], null, null, "home")
medium = Widget([head, state, Row([Metric(today.rows[0].worked, "work", null, "title"), Metric(today.rows[0].paused, "break", null, "title")], 20)], null, null, "home")
circular = Widget([Text(today.rows[0].worked, "headline")])
rectangular = Widget([Text(today.rows[0].state, "headline"), Text("Work " + today.rows[0].worked + " · Break " + today.rows[0].paused, "caption")])
inline = Widget([Text(today.rows[0].state + " · Work " + today.rows[0].worked)])
