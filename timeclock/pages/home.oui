root = Page([hero, stats, list, tools])
total = Query("query", {sql: "WITH e AS (SELECT kind, at, coalesce(lead(at) OVER (ORDER BY at, rowid), CASE WHEN kind = 'end' THEN at ELSE datetime('now', 'localtime') END) AS nxt FROM entries WHERE date(at) = date('now', 'localtime')), m AS (SELECT kind, coalesce(sum(round((julianday(nxt) - julianday(at)) * 1440)), 0) AS n FROM e GROUP BY kind), t AS (SELECT CAST(coalesce(sum(CASE WHEN kind IN ('work', 'trip') THEN n END), 0) AS INTEGER) AS work, CAST(coalesce(sum(CASE WHEN kind = 'break' THEN n END), 0) AS INTEGER) AS brk FROM m), last AS (SELECT kind FROM entries WHERE date(at) = date('now', 'localtime') ORDER BY at DESC, rowid DESC LIMIT 1) SELECT CASE WHEN (SELECT kind FROM last) IS NULL THEN 'Not started' WHEN (SELECT kind FROM last) = 'end' THEN 'Done' ELSE 'Running' END AS state, printf('%d:%02d', work / 60, work % 60) AS worked, printf('%d:%02d', brk / 60, brk % 60) AS paused, work, brk FROM t"}, {rows: [{state: "Not started", worked: "0:00", paused: "0:00", work: 0, brk: 0}]})
last = Query("query", {sql: "WITH t AS (SELECT kind, substr(at, 12, 5) AS hm, id FROM entries WHERE date(at) = date('now', 'localtime')) SELECT coalesce((SELECT kind FROM t ORDER BY hm DESC, id DESC LIMIT 1), '') AS kind, coalesce((SELECT hm FROM t ORDER BY hm DESC, id DESC LIMIT 1), '') AS lasthm, coalesce((SELECT min(hm) FROM t WHERE kind IN ('work', 'trip')), '') AS firsthm"}, {rows: [{kind: "", lasthm: "", firsthm: ""}]})
idle = last.rows[0].kind == ""
title = idle ? "Not started" : last.rows[0].kind == "work" ? "Working since " + last.rows[0].firsthm : last.rows[0].kind == "break" ? "On break since " + last.rows[0].lasthm : last.rows[0].kind == "trip" ? "On a business trip since " + last.rows[0].lasthm : "Done at " + last.rows[0].lasthm
hero = Hero(title, null, "⏱️")
stats = Stats([Stat("Work today", idle ? "—" : total.rows[0].worked, null, "💼"), Stat("Break today", idle ? "—" : total.rows[0].paused, null, "☕")])
entries = Query("query", {sql: "SELECT id, CASE kind WHEN 'work' THEN 'Work' WHEN 'break' THEN 'Break' WHEN 'trip' THEN 'Business trip' ELSE 'End' END AS label, substr(at, 12, 5) AS time, coalesce(place, '') AS place, CASE kind WHEN 'work' THEN '💼' WHEN 'break' THEN '☕' WHEN 'trip' THEN '🚗' ELSE '🏁' END AS icon FROM entries WHERE date(at) = date('now', 'localtime') ORDER BY at DESC, id DESC"}, {rows: []})
list = @Count(entries.rows) == 0 ? Alert("Nothing logged yet", "Start work to begin your day.", "info") : List(@Each(entries.rows, "e", Row(e.time + "  " + e.label, e.place == "" ? null : e.place, e.icon)), "Today")
start = Mutation("run", {sql: "INSERT INTO entries (kind, at, place) VALUES ('work', :today || ' ' || :time, NULL)"})
pause = Mutation("run", {sql: "INSERT INTO entries (kind, at, place) VALUES ('break', :today || ' ' || :time, NULL)"})
trip = Mutation("run", {sql: "INSERT INTO entries (kind, at, place) VALUES ('trip', :today || ' ' || :time, NULL)"})
office = Mutation("run", {sql: "INSERT INTO entries (kind, at, place) VALUES ('end', :today || ' ' || :time, 'Office')"})
home = Mutation("run", {sql: "INSERT INTO entries (kind, at, place) VALUES ('end', :today || ' ' || :time, 'Home office')"})
main = last.rows[0].kind == "work" || last.rows[0].kind == "trip" ? Button("Start break", Action([@Run(pause), @Run(entries), @Run(total), @Run(last)]), "default") : Button("Start work", Action([@Run(start), @Run(entries), @Run(total), @Run(last)]), "default")
primary = Buttons([main], "column")
tripRow = Buttons([Button("Business trip", Action([@Run(trip), @Run(entries), @Run(total), @Run(last)]), "secondary")], "column")
endRow = Buttons([Button("End (office)", Action([@Run(office), @Run(entries), @Run(total), @Run(last)]), "outline"), Button("End (home office)", Action([@Run(home), @Run(entries), @Run(total), @Run(last)]), "outline")], "row")
tools = Card([primary, tripRow, TextContent("End the day", "small-heavy"), endRow, TextContent("Also in Shortcuts, Siri and Control Center.", "small")])
