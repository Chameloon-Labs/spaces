root = Page([headline, bar, cats2, add, recent, daily, byCategory, settings])
month = Query("query", {sql: "SELECT printf('€%.2f', spent) AS spent, printf('€%.2f', max(budget - spent, 0)) AS left, printf('€%,d', CAST(budget AS INTEGER)) AS budget, CAST(round(100.0 * spent / max(budget, 1)) AS INTEGER) AS pct, n, printf('€%.2f', spent / max(CAST(strftime('%d', 'now', 'localtime') AS INTEGER), 1)) AS perDay, strftime('%m', 'now', 'localtime') AS month FROM (SELECT coalesce(sum(amount), 0) AS spent, count(*) AS n, (SELECT CAST(value AS REAL) FROM prefs WHERE key = 'budget') AS budget FROM expenses WHERE strftime('%Y-%m', at, 'localtime') = strftime('%Y-%m', 'now', 'localtime'))"}, {rows: [{spent: "€0.00", left: "€0.00", budget: "€0", pct: 0, n: 0, perDay: "€0.00", month: ""}]})
headline = Metric(month.rows[0].spent, "Spent this month", month.rows[0].left + " left of " + month.rows[0].budget + " · " + month.rows[0].perDay + " a day", month.rows[0].pct + "% used")
bar = Progress(month.rows[0].pct, month.rows[0].n + " expenses")
cats = Query("query", {sql: "SELECT c.name, '/img/' || c.slug || '.svg' AS art, printf('€%.0f', coalesce((SELECT sum(amount) FROM expenses e WHERE e.category = c.name AND strftime('%Y-%m', e.at, 'localtime') = strftime('%Y-%m', 'now', 'localtime')), 0)) AS total FROM (SELECT 'Groceries' AS name, 'groceries' AS slug, 1 AS o UNION ALL SELECT 'Eating out', 'eating-out', 2 UNION ALL SELECT 'Transport', 'transport', 3 UNION ALL SELECT 'Fun', 'fun', 4 UNION ALL SELECT 'Home', 'home', 5 UNION ALL SELECT 'Other', 'other', 6) c ORDER BY c.o"}, {rows: []})
$category = "Groceries"
cats2 = Tiles(@Each(cats.rows, "c", Tile(c.name, c.total + " this month", c.art, c.name == $category ? "✓" : null, Action([@Set($category, c.name)]))), 3)
$amount = ""
$note = ""
save = Mutation("run", {sql: "INSERT INTO expenses (amount, category, note) SELECT round(CAST(replace(?, ',', '.') AS REAL), 2), ?, nullif(trim(?), '') WHERE CAST(replace(?, ',', '.') AS REAL) > 0", params: [$amount, $category, $note, $amount]})
add = Card([CardHeader("New expense", "Pick a category above"), Form("expense", Buttons([Button("Add to " + $category, Action([@Run(save), @Run(month), @Run(recentRows), @Run(cats), @Run(byCat), @Run(days), @Reset($amount, $note)]), "default")]), [FormControl("Amount in €", Input("amount", "12.50", "number", null, $amount)), FormControl("Note (optional)", Input("note", "Lunch", "text", null, $note))])])
recentRows = Query("query", {sql: "SELECT id, printf('€%.2f', amount) AS amount, coalesce(note, category) AS title, category || ' · ' || strftime('%d.%m %H:%M', at, 'localtime') AS sub, '/img/' || CASE category WHEN 'Groceries' THEN 'groceries' WHEN 'Eating out' THEN 'eating-out' WHEN 'Transport' THEN 'transport' WHEN 'Fun' THEN 'fun' WHEN 'Home' THEN 'home' ELSE 'other' END || '.svg' AS art FROM expenses ORDER BY at DESC LIMIT 8"}, {rows: []})
recent = @Count(recentRows.rows) == 0 ? Alert("Nothing spent yet", "Add your first expense above.", "info") : List(@Each(recentRows.rows, "e", Row(e.title, e.sub, e.art, e.amount, @Navigate("expense", {id: e.id}))), "Latest")
days = Query("query", {sql: "WITH RECURSIVE d(n) AS (SELECT 13 UNION ALL SELECT n - 1 FROM d WHERE n > 0) SELECT strftime('%d.%m', 'now', 'localtime', '-' || d.n || ' days') AS label, (SELECT round(coalesce(sum(amount), 0), 2) FROM expenses WHERE date(at, 'localtime') = date('now', 'localtime', '-' || d.n || ' days')) AS total FROM d"}, {rows: []})
daily = Card([CardHeader("Per day", "last two weeks, in €"), LineChart(days.rows.label, [Series("Spent", days.rows.total)])])
byCat = Query("query", {sql: "SELECT category, round(sum(amount), 2) AS total FROM expenses WHERE strftime('%Y-%m', at, 'localtime') = strftime('%Y-%m', 'now', 'localtime') GROUP BY category ORDER BY total DESC"}, {rows: []})
byCategory = Card([CardHeader("Where it went", "this month"), PieChart(@Each(byCat.rows, "c", Slice(c.category, c.total)), true)])
$budget = ""
setBudget = Mutation("run", {sql: "UPDATE prefs SET value = CAST(round(CAST(replace(?, ',', '.') AS REAL)) AS INTEGER) WHERE key = 'budget' AND CAST(replace(?, ',', '.') AS REAL) > 0", params: [$budget, $budget]})
settings = DialogBlock("Change monthly budget", "Monthly budget", "What you want to spend at most each month.", [Form("budget", Buttons([Button("Save", Action([@Run(setBudget), @Run(month), @Reset($budget)]), "default")]), [FormControl("Budget in €", Input("budget", "1200", "number", null, $budget))])], "outline")
