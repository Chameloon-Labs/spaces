root = Page([hero, thread, answer, compose])
hero = Hero("Assistant", "An offline chat: the answers come from SQL in this space. Ask for code, a table or a plan.", "🤖", ["No server", "Markdown"])
msgs = Query("query", {sql: "SELECT text, me, strftime('%H:%M', at, 'localtime') AS time FROM messages ORDER BY id"}, {rows: []})
thread = Thread(msgs.rows)
last = Query("query", {sql: "SELECT lower(text) AS q FROM messages WHERE me = 1 ORDER BY id DESC LIMIT 1"}, {rows: [{q: ""}]})
answer = last.rows[0].q == "" ? null : Card([CardHeader("Last answer, in detail", "What AI elements look like as components"), Accordion([AccordionItem("reasoning", "💭 Reasoning", [TextContent("Looked for the words code, table and plan in your message, picked the matching template and filled it from this space's tables.", "small")]), AccordionItem("sources", "🔗 Sources", [List([Row("tasks table", "5 rows", "🗂️"), Row("sales table", "18 rows", "📈")])])], "multiple"), last.rows[0].q == "" ? null : CodeBlock("SELECT product, sum(revenue) AS total\nFROM sales\nGROUP BY product\nORDER BY total DESC;", "sql", "query.sql")])
$text = ""
send = Mutation("run", {sql: "INSERT INTO messages (text, me) SELECT trim(?), 1 WHERE trim(?) <> ''", params: [$text, $text]})
reply = Mutation("run", {sql: "INSERT INTO messages (text, me) SELECT CASE WHEN lower(?) LIKE '%code%' THEN 'Here''s a page in OpenUI Lang:' || char(10) || char(10) || '```' || char(10) || 'root = Page([hero])' || char(10) || 'hero = Hero(\"Hello\", \"From a space\", \"👋\")' || char(10) || '```' WHEN lower(?) LIKE '%table%' THEN '| Product | Revenue |' || char(10) || '|---|---|' || (SELECT group_concat(char(10) || '| ' || product || ' | €' || total || ' |', '') FROM (SELECT product, CAST(sum(revenue) AS INTEGER) AS total FROM sales GROUP BY product ORDER BY total DESC)) WHEN lower(?) LIKE '%plan%' THEN 'Your plan for today:' || (SELECT group_concat(char(10) || '- ' || title, '') FROM tasks WHERE done = 0) ELSE 'I only know three tricks: ask me for **code**, a **table** or a **plan**.' END, 0 WHERE trim(?) <> ''", params: [$text, $text, $text, $text]})
compose = Composer("text", "Ask for code, a table or a plan", $text, Action([@Run(send), @Run(reply), @Run(msgs), @Run(last), @Reset($text)]))
