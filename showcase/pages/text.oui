root = Page([h1, intro, sizes, sep, md, quote, code, inline, tabs, faq])
h1 = Heading("Text & layout", "h1")
intro = TextContent("Headings, paragraphs, markdown, quotes and code. Everything here is plain OpenUI Lang.", "large")
sizes = Card([Heading("Heading 2", "h2"), Heading("Heading 3", "h3"), Heading("Heading 4", "h4"), TextContent("Large heavy text", "large-heavy"), TextContent("Default text for most paragraphs.", "default"), TextContent("Small heavy", "small-heavy"), TextContent("Small text for hints and footnotes.", "small")])
sep = Separator("horizontal")
md = Card([CardHeader("Markdown", "GitHub flavoured"), MarkDownRenderer("**Bold**, *italic*, `code` and [a link](https://chameloon.com).\n\n- Lists\n- with items\n  - and nesting\n\n1. Numbered\n2. too\n\n| Component | Kind |\n|---|---|\n| Hero | screen |\n| Table | data |\n\n> Quotes work in markdown as well.")])
quote = Blockquote("A space is a small app from a server you trust. It keeps its data on this phone.", "Chameloon")
code = Card([CardHeader("Code blocks", "With a language and a title"), CodeBlock("struct Space: Codable {\n    var name: String\n    var version: Int\n}", "swift", "Space.swift"), CodeBlock("todos = Query(\"query\", {sql: \"SELECT * FROM todos\"}, {rows: []})", "text", "home.oui")])
inline = Card([CardHeader("Inline code", null), InlineCode("Mutation(\"run\", {sql, params})")])
tabs = Tabs([TabItem("what", "What", [TextContent("Tabs switch content without leaving the page.", "default")]), TabItem("how", "How", [TextContent("TabItem(value, trigger, [children]).", "default")]), TabItem("why", "Why", [TextContent("Long pages stay short.", "default")])], "what")
faq = Accordion([AccordionItem("q1", "Where is my data?", [TextContent("In this space's own SQLite file on this phone. Other spaces can't read it.", "default")]), AccordionItem("q2", "Can a space reach the internet?", [TextContent("Only its own server, and only through the app. The page itself has no network.", "default")]), AccordionItem("q3", "Who writes these pages?", [TextContent("You, or an AI: space.json and a few .oui files.", "default")])], "single")
