root = Page([hero, metric, sections, stats, rings, tools, badges])
counts = Query("query", {sql: "SELECT (SELECT count(*) FROM tasks) AS tasks, (SELECT count(*) FROM tasks WHERE done = 1) AS done, (SELECT count(*) FROM messages) AS messages, (SELECT count(*) FROM files) AS files, (SELECT count(*) FROM photos) AS photos, round(1.0 * (SELECT count(*) FROM tasks WHERE done = 1) / max((SELECT count(*) FROM tasks), 1), 2) AS ratio, CAST(round(100.0 * (SELECT count(*) FROM tasks WHERE done = 1) / max((SELECT count(*) FROM tasks), 1)) AS INTEGER) AS pct"}, {rows: [{tasks: 0, done: 0, messages: 0, files: 0, photos: 0, ratio: 0, pct: 0}]})
hero = Hero("Showcase", "Every component a space can draw, on real data from this space's own database.", "/img/hero.svg", ["OpenUI Lang", "Your theme", "SQLite on this phone"])
metric = Metric(counts.rows[0].done + "/" + counts.rows[0].tasks, "Tasks done", "A Metric: one big number, no banner", "+" + counts.rows[0].pct + "%")
stats = Stats([Stat("Tasks", counts.rows[0].done + "/" + counts.rows[0].tasks, null, "✅"), Stat("Messages", "" + counts.rows[0].messages, "+2 today", "💬"), Stat("Files", "" + counts.rows[0].files, null, "📎"), Stat("Photos", "" + counts.rows[0].photos, null, "🖼️")])
rings = Rings([Ring(counts.rows[0].ratio, counts.rows[0].pct + "%", "Tasks done", "#7c3aed"), Ring(0.72, "72%", "Storage", "#06b6d4"), Ring(0.4, "4/10", "Streak", "#f43f5e")])
sections = Tiles([Tile("Charts & data table", "Bar, line, area, pie, radar, radial, scatter, a paged table", "📊", "7 charts", @Navigate("charts")), Tile("Forms & inputs", "Inputs, select, date picker, slider, checkboxes, switches", "📝", null, @Navigate("forms")), Tile("Dialogs & drawers", "Modal, bottom sheet, confirm, alerts, tags", "🪟", null, @Navigate("overlays")), Tile("AI chat", "Thread, composer, markdown, code, reasoning", "🤖", "new", @Navigate("chat")), Tile("Media & files", "Gallery, carousel, images, attachments", "🖼️", null, @Navigate("media")), Tile("Text & layout", "Markdown, quotes, code, tabs, accordion", "🔤", null, @Navigate("text"))], 2)
here = Mutation("location", {})
ping = Mutation("notify", {title: "Showcase", body: "Notifications work. This one came from the space, after you tapped.", in: 5})
$toolNote = ""
tools = Card([CardHeader("Phone features", "Each one asks first and only runs after a tap"), Buttons([Button("📍 Where am I?", Action([@Run(here), @Set($toolNote, "You're at " + here.data.lat + ", " + here.data.lon + " (±" + here.data.accuracy + " m).")]), "secondary"), Button("🔔 Notify me in 5 s", Action([@Run(ping), @Set($toolNote, "Lock your phone: the notification comes in 5 seconds.")]), "secondary")], "column"), $toolNote == "" ? TextContent("Location and notifications are switched per space in About this space.", "small") : Alert("Done", $toolNote, "success")])
badges = Card([CardHeader("Badges", null), TagBlock([Tag("default"), Tag("secondary", "secondary"), Tag("outline", "outline"), Tag("destructive", "destructive"), Tag("ghost", "ghost")])])
