root = Page([hero, tabs, tableCard, goals])
m = Query("query", {sql: "SELECT substr(month, 6, 2) || '/' || substr(month, 3, 2) AS label, sum(revenue) AS total, sum(units) AS units, sum(CASE product WHEN 'Basic' THEN revenue ELSE 0 END) AS basic, sum(CASE product WHEN 'Pro' THEN revenue ELSE 0 END) AS pro, sum(CASE product WHEN 'Team' THEN revenue ELSE 0 END) AS team FROM sales GROUP BY month ORDER BY month"}, {rows: []})
byProduct = Query("query", {sql: "SELECT product, sum(revenue) AS total, sum(units) AS units FROM sales GROUP BY product ORDER BY total DESC"}, {rows: []})
points = Query("query", {sql: "SELECT units, revenue, product || ' ' || substr(month, 6, 2) AS label FROM sales ORDER BY month"}, {rows: []})
sum = Query("query", {sql: "SELECT printf('€%,d', sum(revenue)) AS revenue, printf('%,d', sum(units)) AS units FROM sales"}, {rows: [{revenue: "€0", units: "0"}]})
hero = Hero(sum.rows[0].revenue, "revenue over 6 months · " + sum.rows[0].units + " units", "📊", ["Basic", "Pro", "Team"])
tabs = Tabs([TabItem("bar", "Bar", [BarChart(m.rows.label, [Series("Basic", m.rows.basic), Series("Pro", m.rows.pro), Series("Team", m.rows.team)], null, "Month", "€")]), TabItem("line", "Line", [LineChart(m.rows.label, [Series("Revenue", m.rows.total)], "Month", "€")]), TabItem("area", "Area", [AreaChart(m.rows.label, [Series("Pro", m.rows.pro), Series("Team", m.rows.team)])]), TabItem("pie", "Pie", [PieChart(@Each(byProduct.rows, "p", Slice(p.product, p.total)), true)]), TabItem("radar", "Radar", [RadarChart(m.rows.label, [Series("Units", m.rows.units)])]), TabItem("radial", "Radial", [RadialChart(@Each(byProduct.rows, "p", Slice(p.product, p.units)))]), TabItem("scatter", "Scatter", [ScatterChart([ScatterSeries("Units vs revenue", @Each(points.rows, "r", Point(r.units, r.revenue, r.label)))], "Units", "€")])], "bar")
$page = "1"
rows = Query("query", {sql: "SELECT month, product, units, printf('€%,d', revenue) AS revenue FROM sales ORDER BY month DESC, revenue DESC LIMIT 6 OFFSET (CAST(? AS INTEGER) - 1) * 6", params: [$page]}, {rows: []})
tableCard = Card([CardHeader("Sales", "a data table, 6 rows a page"), Table([Col("Month", "string"), Col("Product", "string"), Col("Units", "number"), Col("Revenue", "string")], @Each(rows.rows, "r", [r.month, r.product, r.units, r.revenue])), Chips(["1", "2", "3"], $page), PaginationBlock(3, 3)])
goals = Card([CardHeader("Goals", "Progress bars"), Progress(82, "Revenue goal"), Progress(55, "New customers"), Progress(23, "Team plan upgrades")])
