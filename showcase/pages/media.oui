root = Page([hero, people, gallery, carousel, single, addMedia, attachments])
photos = Query("query", {sql: "SELECT src, alt FROM photos ORDER BY id DESC"}, {rows: []})
hero = Hero("Media", "Photos, a carousel and attachments. New ones come from your camera, library or files.", "🖼️", null, null, null, photos.rows[0].src)
people = Card([CardHeader("Avatars", null), Avatar(null, "Ada", "AL"), Avatar(photos.rows[0].src, "Photo", "PH")])
gallery = Card([CardHeader("Gallery", "Tap a photo to open it full screen"), Gallery(photos.rows, 3)])
carousel = Carousel(@Each(photos.rows, "p", [ImageBlock(p.src, p.alt, p.alt)]), "card")
single = Card([CardHeader("Image", null), Image(photos.rows[0].src, photos.rows[0].alt)])
cam = Mutation("photo", {source: "camera"})
lib = Mutation("photo", {source: "library"})
keepCam = Mutation("run", {sql: "INSERT INTO photos (src, alt) VALUES (?, 'From the camera')", params: [cam.data.uri]})
keepLib = Mutation("run", {sql: "INSERT INTO photos (src, alt) VALUES (?, 'From the library')", params: [lib.data.uri]})
pick = Mutation("file", {})
keepFile = Mutation("run", {sql: "INSERT INTO files (name, type, size, uri) VALUES (?, ?, ?, ?)", params: [pick.data.name, pick.data.type, pick.data.size, pick.data.uri]})
addMedia = Buttons([Button("📷 Take a photo", Action([@Run(cam), @Run(keepCam), @Run(photos)]), "default"), Button("🖼️ Choose a photo", Action([@Run(lib), @Run(keepLib), @Run(photos)]), "secondary"), Button("📎 Attach a file", Action([@Run(pick), @Run(keepFile), @Run(files)]), "secondary")], "column")
files = Query("query", {sql: "SELECT name, type, size, uri, strftime('%d.%m %H:%M', at, 'localtime') AS sub FROM files ORDER BY id DESC"}, {rows: []})
attachments = Files(@Each(files.rows, "f", File(f.name, f.type, f.size, f.uri, f.sub)), "Attachments · tap to open or share")
