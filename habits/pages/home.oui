root = Page([hero, rings, grid, add, weekCard, remind])
progress = Query("query", {sql: "SELECT done, total, round(1.0 * done / max(total, 1), 2) AS ratio, CAST(round(100.0 * done / max(total, 1)) AS INTEGER) AS pct, week, round(min(1.0, 1.0 * week / max(total * 7, 1)), 2) AS weekRatio, CAST(round(100.0 * week / max(total * 7, 1)) AS INTEGER) AS weekPct FROM (SELECT (SELECT count(*) FROM checks WHERE day = date('now', 'localtime')) AS done, (SELECT count(*) FROM habits) AS total, (SELECT count(*) FROM checks WHERE day > date('now', 'localtime', '-7 days')) AS week)"}, {rows: [{done: 0, total: 0, ratio: 0, pct: 0, week: 0, weekRatio: 0, weekPct: 0}]})
hero = Hero(progress.rows[0].total > 0 && progress.rows[0].done == progress.rows[0].total ? "All done! 🎉" : progress.rows[0].done + " of " + progress.rows[0].total + " today", "Tap a card when you've done it. Small steps, every day.", "/img/hero.svg", ["Stays on this phone"])
rings = Rings([Ring(progress.rows[0].ratio, progress.rows[0].pct + "%", "Today", "#f43f5e"), Ring(progress.rows[0].weekRatio, progress.rows[0].weekPct + "%", "This week", "#f97316")])
habits = Query("query", {sql: "WITH RECURSIVE s(habit, day, n) AS (SELECT id, CASE WHEN EXISTS (SELECT 1 FROM checks c WHERE c.habit = habits.id AND c.day = date('now', 'localtime')) THEN date('now', 'localtime') ELSE date('now', 'localtime', '-1 day') END, 0 FROM habits UNION ALL SELECT s.habit, date(s.day, '-1 day'), s.n + 1 FROM s JOIN checks c ON c.habit = s.habit AND c.day = s.day) SELECT h.id, h.name, coalesce(h.art, '/img/habit.svg') AS art, h.emoji, EXISTS (SELECT 1 FROM checks c WHERE c.habit = h.id AND c.day = date('now', 'localtime')) AS done, (SELECT max(n) FROM s WHERE s.habit = h.id) AS streak FROM habits h ORDER BY done, h.created"}, {rows: []})
$picked = ""
uncheck = Mutation("run", {sql: "DELETE FROM checks WHERE habit = ? AND day = date('now', 'localtime')", params: [$picked]})
check = Mutation("run", {sql: "INSERT INTO checks (habit, day) SELECT ?, date('now', 'localtime') WHERE changes() = 0", params: [$picked]})
grid = @Count(habits.rows) == 0 ? Alert("No habits yet", "Add a small one below. Two minutes is enough to start.", "info") : Tiles(@Each(habits.rows, "h", Tile(h.name, h.streak > 0 ? "🔥 " + h.streak + (h.streak == 1 ? " day" : " days") + " in a row" : "Start a streak today", h.art, h.done == 1 ? "✓ Done" : null, Action([@Set($picked, h.id), @Run(uncheck), @Run(check), @Run(habits), @Run(progress), @Run(days)]))), 2)
$name = ""
$emoji = ""
create = Mutation("run", {sql: "INSERT INTO habits (name, emoji) SELECT trim(?), coalesce(nullif(trim(?), ''), '✨') WHERE trim(?) <> ''", params: [$name, $emoji, $name]})
add = DrawerBlock("➕ New habit", "New habit", "Something small you want to do every day.", [Form("habit", Buttons([Button("Add habit", Action([@Run(create), @Run(habits), @Run(progress), @Reset($name, $emoji)]), "default")]), [FormControl("Habit", Input("name", "Stretch for 5 minutes", "text", null, $name)), FormControl("Emoji", Input("emoji", "🧘", "text", null, $emoji))])], "outline")
days = Query("query", {sql: "WITH RECURSIVE d(n) AS (SELECT 13 UNION ALL SELECT n - 1 FROM d WHERE n > 0) SELECT strftime('%d.%m', 'now', 'localtime', '-' || d.n || ' days') AS label, (SELECT count(*) FROM checks WHERE day = date('now', 'localtime', '-' || d.n || ' days')) AS n FROM d"}, {rows: []})
weekCard = Card([CardHeader("Ticked off", "per day, last 2 weeks"), AreaChart(days.rows.label, [Series("Habits", days.rows.n)])])
tonight = Query("query", {sql: "SELECT CAST(round((julianday(date('now', 'localtime') || ' 20:00') - julianday('now', 'localtime')) * 86400) AS INTEGER) + CASE WHEN time('now', 'localtime') >= '20:00' THEN 86400 ELSE 0 END AS secs"}, {rows: [{secs: 3600}]})
reminder = Mutation("notify", {title: "Habits", body: "A few habits are still open today. One tap each.", in: tonight.rows[0].secs})
$reminded = ""
remind = Card([CardHeader("Evening nudge", "One reminder at 20:00, from this phone"), Buttons([Button("⏰ Remind me at 20:00", Action([@Run(tonight), @Run(reminder), @Set($reminded, "We'll remind you at 20:00.")]), "secondary")]), $reminded == "" ? null : Alert("Reminder set", $reminded, "success")])
