# Bike log · one bike, opened with its $id (the scanned tag, or a row on the home page).
root = Page([hero, stats, serviceBar, recent, tag], b.rows[0].name)
b = Query("query", {sql: "SELECT id, name, art, every, CAST(round(odo) AS INTEGER) AS odo, CAST(round(odo - serviced_at) AS INTEGER) AS since, CAST(round(every - (odo - serviced_at)) AS INTEGER) AS left, min(100, CAST(round((odo - serviced_at) * 100.0 / every) AS INTEGER)) AS pct, (SELECT printf('%.0f', coalesce(sum(r.km), 0)) FROM rides r WHERE r.bike = x.id AND r.done = 1 AND r.day > date('now', 'localtime', '-7 days')) AS week, (SELECT count(*) FROM rides r WHERE r.bike = x.id AND r.done = 1) AS n FROM (SELECT b.*, b.km_base + coalesce((SELECT sum(r.km) FROM rides r WHERE r.bike = b.id AND r.done = 1), 0) AS odo FROM bikes b) x WHERE id = replace(?, 'bike:', '')", params: [$id]}, {rows: [{id: "", name: "Bike", art: "", every: 500, odo: 0, since: 0, left: 500, pct: 0, week: "0", n: 0}]})
hero = Hero(b.rows[0].name, b.rows[0].odo + " km on the clock", b.rows[0].art, ["bike:" + b.rows[0].id])
stats = Stats([Stat("This week", b.rows[0].week + " km", null, "📆"), Stat("Rides", "" + b.rows[0].n, null, "🚴")])
serviceBar = Card([CardHeader("Service", "every " + b.rows[0].every + " km"), Progress(b.rows[0].pct, b.rows[0].left <= 0 ? "Due now · " + b.rows[0].since + " km since the last one" : b.rows[0].left + " km to go")])
rows = Query("query", {sql: "SELECT r.id, r.name, printf('%g km', r.km) AS km, CASE WHEN r.day = date('now', 'localtime') THEN 'Today' WHEN r.day = date('now', 'localtime', '-1 day') THEN 'Yesterday' WHEN r.day = date('now', 'localtime', '+1 day') THEN 'Tomorrow' ELSE strftime('%a %d.%m.', r.day) END AS sub FROM rides r WHERE r.bike = replace(?, 'bike:', '') AND r.done = 1 ORDER BY r.day DESC, r.created DESC LIMIT 6", params: [$id]}, {rows: []})
recent = @Count(rows.rows) == 0 ? Alert("No rides yet", "Log one on the home page.", "info") : List(@Each(rows.rows, "r", Row(r.name, r.sub, "icon:calendar-check", r.km)), "Recent rides")
tag = Card([CardHeader("Tag on the frame", "Scan it from the home page"), TextContent("The QR code on this bike holds **bike:" + b.rows[0].id + "**. Scanning it opens this page.", "small")])
